<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.arcadiadevs</groupId>
    <artifactId>ValoriaTycoon</artifactId>
    <version>1.6.3</version>
    <name>ValoriaTycoon</name>
    <description>Plugin ValoriaTycoon pour serveur Minecraft Tycoon et SkyBlock</description>

    <!-- Dépôt de l'API serveur, en portée « provided » uniquement : rien n'est embarqué dans le
         JAR (le serveur fournit déjà ces classes). Aucune autre dépendance externe : l'API
         d'économie est écrite dans ce dépôt et compilée ici (plus aucun artifact d'API distant),
         voir sources/api/xyz/arcadiadevs/valoriateconomy/. -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Classes déjà livrées (GuiLib, XSeries, ChatUtil, classes du plugin) : generated
             par scripts/build-reference-jar.py, pour compiler une classe isolément contre le
             binaire réellement distribué. -->
        <dependency>
            <groupId>local.reference</groupId>
            <artifactId>valoria-reference</artifactId>
            <version>${project.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/artifacts/reference/valoria-renamed.jar</systemPath>
        </dependency>
    </dependencies>

    <properties>
        <!-- Bytecode 17 : c'est la version de classe déjà utilisée par les classes livrées dans
             artifacts/extracted (major 61). Viser 25 rendrait le JAR inutilisable sur les
             serveurs plus anciens, sans rien apporter sur Paper 26.2 (qui exige Java 25 au
             runtime mais accepte une classe majeure 61). -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <finalName>ValoriaTycoon-v1.6.3</finalName>
        <!-- Le dépôt conserve les sources décompilées du JAR comme référence relisible : elles ne
             sont pas toutes compilables en l'état. La compilation est donc ciblée (voir includes
             du maven-compiler-plugin) sur les classes maintenues ici. La phase compile s'exécute
             après process-resources, la classe produite écrase donc son équivalent précompilé copié
             depuis artifacts/extracted et se retrouve dans le JAR final. -->
        <sourceDirectory>${project.basedir}/sources</sourceDirectory>
        <resources>
            <resource>
                <directory>artifacts/extracted</directory>
                <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <!-- Les descripteurs JPMS sont réinsérés en prepare-package (voir maven-resources-plugin
                         ci-dessous). Ils ne doivent PAS être présents dans target/classes pendant la
                         compilation : ce dossier est sur le classpath de javac, et une entrée de classpath
                         contenant module-info.class est traitée comme un module nommé. module-info.class y
                         déclare « requires com.google.gson » (le module de gson/recordadapter embarqué),
                         impossible à résoudre depuis un classpath de compilation vide :
                         « module not found: com.google.gson », et le build échoue avant même de compiler. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/9/module-info.class</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- Aucun fichier implicite ne doit être compilé au passage : la seule source
                         reachable depuis les deux fichiers maintenus doit être le JDK. -->
                    <compilerArgs>
                        <arg>-implicit:none</arg>
                    </compilerArgs>
                    <includes>
                        <!-- Détection de version serveur (Paper 26.x) : compilée depuis
                             sources/plugin, remplace la classe livrée dans le JAR. -->
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/utils/ServerVersion.java</include>
                        <!-- Économie interne (plugin séparé, même build) : le fournisseur est
                             généré (surface d'interface vérifiée), les autres sont écrits à la main. -->
                        <include>economy/xyz/arcadiadevs/valoriaeconomy/ValoriaEconomy.java</include>
                        <include>economy/xyz/arcadiadevs/valoriaeconomy/Balances.java</include>
                        <include>economy/xyz/arcadiadevs/valoriaeconomy/MoneyCommand.java</include>
                        <include>economy/xyz/arcadiadevs/valoriaeconomy/ValoriaEconomyProvider.java</include>
                        <!-- API d'économie interne : la meme classe est compilee ici (pour le code
                             du plugin qui l'appelle) et reprise dans le jar de ValoriaEconomy (pour
                             le fournisseur qui l'implémente). Une seule source, deux jars. -->
                        <include>api/xyz/arcadiadevs/valoriateconomy/Economy.java</include>
                        <include>api/xyz/arcadiadevs/valoriateconomy/EconomyResponse.java</include>
                        <!-- Hologrammes écrits ici (entités armures, API Bukkit seule) : remplacent
                             la bibliothèque embarquée qui exigeait ProtocolLib + un plugin HoloEasy.
                             Le bytecode livré appelle ces signatures exactes. -->
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HoloEasy.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HologramPool.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/Hologram.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HologramBuilder.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HologramSetupGroup.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HologramRegisterGroup.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/hologram/HologramStore.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/utils/HologramsUtil.java</include>
                        <!-- Pont NBT vers PersistentDataContainer : remplace la bibliothèque embarquée,
                             dont les cibles obfusquées ont disparu des serveurs Paper récents. Le repli
                             historique reste livré sous io.github...LegacyNbtBridge. -->
                        <include>shaded/io/github/bananapuncher714/nbteditor/NBTEditor.java</include>
                        <!-- Interface d'amélioration : un bouton d'action + une case statistiques,
                             et substitution de %upgradePrice% sur les deux cases. -->
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/guis/UpgradeGui.java</include>
                        <!-- Marché entre joueurs (/ah) : le listener est le point d'entrée des
                             commandes, AuctionHouse garde le séquestre, AuctionGui la vue partagée. -->
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/commands/SellCommandListener.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/commands/AuctionHouse.java</include>
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/guis/AuctionGui.java</include>
                        <!-- Tableau de bord latéral : affichage résolu par réflexion (API scoreboard
                             redéfinie en 1.21+), donc insensible aux suppressions de Paper 26.x. -->
                        <include>plugin/xyz/arcadiadevs/valoriatycoon/utils/ScoreboardService.java</include>
                        <!-- Multi-outil a ames commutantes (troisieme jar du meme build). Chaque
                             fichier est ici parce que le paquet est compile en bloc : un seul
                             include par source, sinon javac perd la trace de ce qui doit etre
                             ecrit dans target/classes. -->
                        <include>tools/xyz/arcadiadevs/valariatools/ValoriaTools.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolKind.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolsConfig.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolStore.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolStats.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/EconomyService.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/BlockMatcher.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/Abilities.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolListener.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/MultiTool.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolsGui.java</include>
                        <include>tools/xyz/arcadiadevs/valariatools/ToolsCommand.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <!-- prepare-package s'exécute après compile et avant package : les descripteurs
                             reviennent dans target/classes juste à temps pour le JAR, sans jamais gêner
                             javac. Le paquet final reste identique à artifacts/extracted. -->
                        <id>restore-module-descriptors</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>artifacts/extracted</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                        <include>META-INF/versions/9/module-info.class</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestFile>artifacts/extracted/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                    <excludes>
                        <!-- Les classes du plugin d'économie vivent dans leur propre paquet. -->
                        <exclude>xyz/arcadiadevs/valoriaeconomy/**</exclude>
                        <exclude>xyz/arcadiadevs/valariatools/**</exclude>
                        <!-- Filets : ces arbres ne doivent plus jamais revenir dans un paquet livré,
                             ils étaient ceux de bibliothèques tierces remplacées par du code du dépôt. -->
                        <exclude>org/holoeasy/**</exclude>
                        <exclude>net/milkbowl/**</exclude>
                        <!-- l'API d'economie ne vit que dans ce jar : voir src/assembly/economy.xml -->
                        <exclude>META-INF/holoeasy-core.kotlin_module</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>economy-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/economy.xml</descriptor>
                            </descriptors>
                            <!-- LE NOM FINAL SE DECIDE ICI, pas dans le descripteur : le schema
                                 assembly-2.1.0 n'autorise pas le tag finalName a la racine d'un
                                 descripteur (erreur `Unrecognised tag: 'finalName'`, build
                                 #33155795647), et `appendAssemblyId=true` herite du finalName global
                                 du build ... donc `ValoriaTycoon-v1.6.3-economy.jar`, le fichier que
                                 l'etape antrun cherchait en vain (build #33156892660).
                                 `finalName` + `appendAssemblyId=false` donne exactement
                                 target/ValoriaEconomy-v1.6.3.jar, le nom attendu par plugin.yml, la CI
                                 et docs/DEPLOY-2-JARS.md, sans seconde étape de renommage. -->
                            <finalName>ValoriaEconomy-v${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- ValoriaTools : troisieme plugin du build. Meme mecanique de nommage que
                             l'economie — le nom final est un PARAMETRE du plugin, jamais un tag du
                             descripteur (l'XSD ne le permet qu'a l'interieur d'un format). -->
                        <id>tools-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/tools.xml</descriptor>
                            </descriptors>
                            <finalName>ValoriaTools-v${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
