<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
  <!-- ValoriaEconomy : plugin autonome (jar déposé tel quel dans plugins/).
       Les classes viennent de target/classes (compilation ciblée du même build), le plugin.yml et le
       config.yml viennent de resources-economy/ pour ne pas entrer dans le paquet de ValoriaTycoon. -->
  <id>economy</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <!-- PAS de finalName ici : l'XSD du descripteur d'assemblage ne le definit QUE pour un format
       multiple (formatsformatfinalName). Avec un seul formatjar/format, la lecture du
       descripteur echoue (`Unrecognised tag: 'finalName'`, vu sur le build #33155795647) : Maven
       n'attend PAS un message plus clair, il casse avant d'avoir compile quoi que ce soit.
       Le nom final est donc pose par l'execution `rename-economy-jar` (maven-antrun-plugin) du
       pom.xml, qui depend de cette presence de ideconomy/id. -->
  <fileSets>
    <fileSet>
      <directory>${project.build.directory}/classes</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>xyz/arcadiadevs/valoriaeconomy/**</include>
        <!-- L'API (xyz/arcadiadevs/valoriateconomy) vit ICI, dans le jar du FOURNISSEUR : ce plugin
             est load: STARTUP, donc chargé avant tous les POSTWORLD — au moment de SON chargement,
             le classloader de ValoriaTycoon n'existe pas encore, et lui emprunter l'interface
             rendait ce plugin invalide dès le chargement (« Could not load plugin », Economy rouge
             sur le serveur le 2026-08-30). Auto-porteur, il se charge quel que soit l'ordre ; et
             l'unicité de la classe est préservée : ValoriaTycoon (qui déclare softdepend:
             ValoriaEconomy) résout l'interface PAR DÉLÉGATION vers ce jar — la même classe que
             celle du service enregistré, jamais deux Class objects. -->
        <include>xyz/arcadiadevs/valoriateconomy/**</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/resources-economy</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>plugin.yml</include>
        <include>config.yml</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
