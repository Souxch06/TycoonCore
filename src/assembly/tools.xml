<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
  <!-- ValoriaTools : troisieme plugin autonome (jar depose tel quel dans plugins/).
       Les classes viennent de target/classes (compilation ciblée du même build) ; les deux fichiers
       de configuration viennent de resources-tools/, renommes en vol : dans le jar ils DOIVENT s'appeler
       config.yml et plugin.yml (Bukkit ne connait que ces deux noms), mais dans le depot ils vivent
       sous resources-tools/ pour ne pas ecraser ceux de ValoriaTycoon. -->
  <id>tools</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.build.directory}/classes</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>xyz/arcadiadevs/valariatools/**</include>
      </includes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>${project.basedir}/resources-tools/plugin.yml</source>
      <outputDirectory>/</outputDirectory>
      <destName>plugin.yml</destName>
      <filtered>false</filtered>
    </file>
    <file>
      <source>${project.basedir}/resources-tools/config.yml</source>
      <outputDirectory>/</outputDirectory>
      <destName>config.yml</destName>
      <filtered>false</filtered>
    </file>
  </files>
</assembly>
